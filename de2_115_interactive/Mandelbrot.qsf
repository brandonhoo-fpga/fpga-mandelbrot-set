set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to o_VGA_Clk

set_location_assignment PIN_F11 -to o_VGA_Blank_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to o_VGA_Blank_n

set_location_assignment PIN_C10 -to o_VGA_Sync_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to o_VGA_Sync_n
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "2.5 V"

#============================================================
# SWITCHES AND BUTTONS
#============================================================
set_location_assignment PIN_AB28 -to i_Switch
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to i_Switch
set_location_assignment PIN_M23 -to i_Button1
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to i_Button1
set_location_assignment PIN_M21 -to i_Button2
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to i_Button2
set_location_assignment PIN_N21 -to i_Button3
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to i_Button3
set_location_assignment PIN_R24 -to i_Button4
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to i_Button4

set_global_assignment -name QIP_FILE PLL_25MHz.qip
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top