set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to o_VGA_HSync

set_location_assignment PIN_C13 -to o_VGA_VSync
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to o_VGA_VSync

