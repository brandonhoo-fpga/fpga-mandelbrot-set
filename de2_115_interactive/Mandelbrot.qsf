#============================================================
set_location_assignment PIN_D12 -to o_VGA_Blu_7
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to o_VGA_Blu_7
set_location_assignment PIN_D11 -to o_VGA_Blu_6
